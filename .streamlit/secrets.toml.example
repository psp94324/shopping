# 이 파일을 secrets.toml 로 복사해서 값을 채우세요. (secrets.toml 은 git에 올리지 않습니다)
# Streamlit Community Cloud 에서는 앱 설정 > Secrets 에 같은 내용을 붙여넣습니다.

# 여러 기기가 함께 쓰는 데이터베이스 주소.
# 비워두면 로컬 SQLite 파일(shopping.db)을 사용합니다. (Cloud에서는 재시작 시 초기화되므로 반드시 설정)
# Supabase: Project Settings > Database > Connection string > URI (Session pooler 권장)
database_url = "postgresql://postgres.xxxxxxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# 앱 접속 비밀번호. 비워두거나 지우면 비밀번호 없이 열립니다.
app_password = "원하는-비밀번호"
